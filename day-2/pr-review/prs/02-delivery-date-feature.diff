+++ b/orders/delivery.py
@@ -0,0 +1,24 @@
+"""Estimated delivery dates. Only working days (Monday to Friday) count; public holidays are ignored for now."""
+from datetime import date, timedelta
+
+STANDARD_WORKING_DAYS = 3
+EXPRESS_WORKING_DAYS = 1
+
+
+def add_working_days(start: date, days: int) -> date:
+    """The date that is `days` working days after `start`. The start day itself is not counted."""
+    if days < 0:
+        raise ValueError("days must not be negative")
+    current = start
+    remaining = days
+    while remaining > 0:
+        current += timedelta(days=1)
+        if current.weekday() < 5:        # 0 = Monday ... 4 = Friday
+            remaining -= 1
+    return current
+
+
+def delivery_date(order_date: date, express: bool = False) -> date:
+    """Estimated delivery date: 3 working days, or 1 working day for express."""
+    days = EXPRESS_WORKING_DAYS if express else STANDARD_WORKING_DAYS
+    return add_working_days(order_date, days)
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,29 @@
+import unittest
+from datetime import date
+
+from orders.delivery import add_working_days, delivery_date
+
+
+class DeliveryTests(unittest.TestCase):
+    def test_midweek_standard(self):
+        self.assertEqual(delivery_date(date(2026, 12, 1)), date(2026, 12, 4))      # Tue -> Fri
+
+    def test_friday_order_skips_weekend(self):
+        self.assertEqual(delivery_date(date(2026, 12, 4)), date(2026, 12, 9))      # Fri -> Wed
+
+    def test_express(self):
+        self.assertEqual(delivery_date(date(2026, 12, 4), express=True), date(2026, 12, 7))  # Fri -> Mon
+
+    def test_saturday_order(self):
+        self.assertEqual(add_working_days(date(2026, 12, 5), 1), date(2026, 12, 7))
+
+    def test_zero_days(self):
+        self.assertEqual(add_working_days(date(2026, 12, 5), 0), date(2026, 12, 5))
+
+    def test_negative_days_rejected(self):
+        with self.assertRaises(ValueError):
+            add_working_days(date(2026, 12, 1), -1)
+
+
+if __name__ == "__main__":
+    unittest.main()
