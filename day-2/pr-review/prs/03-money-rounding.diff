--- /dev/null
+++ b/tests/test_bulk_discount.py
@@ -0,0 +1,16 @@
+import unittest
+from decimal import Decimal
+
+from orders.pricing import line_total
+
+
+class BulkDiscountTests(unittest.TestCase):
+    def test_large_order_gets_ten_percent_off(self):
+        self.assertEqual(line_total(Decimal("10.00"), 200, False), Decimal("1800.00"))
+
+    def test_small_order_pays_full_price(self):
+        self.assertEqual(line_total(Decimal("10.00"), 5, False), Decimal("50.00"))
+
+
+if __name__ == "__main__":
+    unittest.main()
