 def get_orders_for_customer(conn: sqlite3.Connection, customer_id: int) -> list:
     return conn.execute("SELECT id, gross FROM orders WHERE customer_id = ?", (customer_id,)).fetchall()
+
+
+def search_customers(conn: sqlite3.Connection, name_fragment: str) -> list:
+    """Support team search: customers whose name contains the fragment."""
+    query = "SELECT id, name, email FROM customers WHERE name LIKE '%" + name_fragment + "%'"
+    return conn.execute(query).fetchall()
